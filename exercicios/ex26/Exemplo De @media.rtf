@media screen and (min-width: 768px)  /* sem media interna, uso arquivos separados */\{\
  /* 1. Aumentar tamanhos de texto */\
  h1 \{\
    font-size: 24px;\
  \}\
\
  input,\
  select,\
  textarea,\
  label \{\
    font-size: 1.1rem;\
  \}\
\
  /* 2. Layout em colunas para campos duplos */\
  .duplo \{\
    display: flex;\
    gap: 20px;\
  \}\
\
